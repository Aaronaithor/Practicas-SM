  <step>
    <name>Producto + Proveedores + Categorias</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>PracticasSM</connection>
    <sql>SELECT
  producto_id as pid
, p.nombre as n_p
, p.categoria_id
, p.proveedor_id
, precio as price
, pr.nombre as n_pr
, c.nombre as n_c
FROM oltp_catalogo.productos p JOIN 
	oltp_catalogo.proveedores pr ON p.proveedor_id = pr.proveedor_id
JOIN oltp_catalogo.categorias c ON c.categoria_id = p.categoria_id
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
