    <connection>PracticasSM</connection>
    <sql>SELECT 
    c.nombre, 
    d.ciudad, 
    d.pais, 
    c.email
FROM 
    oltp_clientes.clientes c
JOIN 
    oltp_clientes.direcciones d ON c.cliente_id = d.cliente_id;</sql>
    <limit>0</limit>
    <lookup/>
