oltp_pedidos.lineas_pedido lp ON lp.pedido_id = p.pedido_id JOIN
datawarehouse.dim_fecha f ON f.fecha = p.fecha_pedido LEFT JOIN
oltp_envios.envios e ON p.pedido_id = e.pedido_id</sql>
