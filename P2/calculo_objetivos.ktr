    <connection>PracticasSM</connection>
    <sql>SELECT
    dp.categoria,
    SUM(dp.precio) AS ventas_totales
FROM datawarehouse.hechos_ventas hv
JOIN datawarehouse.dim_producto dp
    ON hv.producto_id = dp.producto_id
GROUP BY dp.categoria;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
